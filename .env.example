# =============================================================================
# AI Support Bot — Environment Configuration
# Copy to .env and fill in values. NEVER commit .env to source control.
# =============================================================================

# --- Application ---
APP_ENV=development
APP_NAME=support-ai
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1
APP_CORS_ORIGINS=["http://localhost:3000"]

# --- Database (Supabase PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres:Trendlance%40123@db.xxdmaifjosqcjpfljnqp.supabase.co:5432/postgres/support_ai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=support-documents

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=support-ai:
REDIS_DEFAULT_TTL=3600

# --- Gemini ---
GEMINI_API_KEY=AIzaSy_your-api-key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MAX_TOKENS=2048
GEMINI_TEMPERATURE=0.1
GEMINI_TIMEOUT=30
GEMINI_MAX_RETRIES=3

# --- Embeddings ---
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=64

# --- RAG ---
RAG_TOP_K=20
RAG_RERANK_TOP_K=5
RAG_CONTEXT_TOKEN_LIMIT=3000
RAG_MIN_CONFIDENCE=0.3
RAG_HYBRID_SEMANTIC_WEIGHT=0.7
RAG_HYBRID_KEYWORD_WEIGHT=0.3

# --- Chunking ---
CHUNK_TARGET_SIZE=512
CHUNK_MAX_SIZE=1024
CHUNK_OVERLAP=64
CHUNK_MIN_SIZE=50

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_HOUR=10
RATE_LIMIT_GLOBAL_CONCURRENT=100

# --- Workers (Celery) ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_MAX_RETRIES=3

# --- Storage ---
MAX_UPLOAD_SIZE_MB=50
ALLOWED_MIME_TYPES=["application/pdf"]
STORAGE_PATH_PREFIX=documents

# --- Security ---
INTERNAL_SERVICE_SECRET=your-internal-service-secret-min-32-chars
API_KEY_HEADER=X-API-Key
INTERNAL_AUTH_HEADER=X-Service-Auth
USER_ID_HEADER=X-User-ID

# --- Observability ---
OTEL_ENABLED=false
OTEL_SERVICE_NAME=support-ai
OTEL_EXPORTER_ENDPOINT=http://localhost:4317
METRICS_ENABLED=true
METRICS_PORT=9090
